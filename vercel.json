{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/build_vercel_catalog.py",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/", "destination": "/index.html"}
  ],
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "includeFiles": "data/{deployment_catalog.db,public_guidance.json,map_points.json,vaccination_guidance.json,examination_guidance.json,official_services.json}",
      "excludeFiles": "{.tools/**,.env*,tests/**,reports/**,사진/**,**/*.xlsx}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'"},
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]
    }
  ]
}
