# 현재 앱은 SQLite 전용. Vercel은 별도 읽기 전용 배포 카탈로그를 사용합니다.
DATA_BACKEND=sqlite
SQLITE_PATH=data/health_search.db

# LLM 보조검색: 처음에는 false
ENABLE_LLM=false
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6

# 문자 발송: 처음에는 mock
# 실제 발송: 등록된 발신번호/유효한 API 인증정보/잔액을 확인한 뒤 live로 전환.
# 키는 서버에만 설정합니다. 실제 수신 완료와 서비스 접수 성공은 다릅니다.
SMS_MODE=mock
SOLAPI_API_KEY=YOUR_SOLAPI_API_KEY
SOLAPI_API_SECRET=YOUR_SOLAPI_API_SECRET
SOLAPI_SENDER=YOUR_REGISTERED_SENDER_NUMBER

# Supabase 운영 전환 때 입력
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_SERVER_KEY

# Vercel 실제 문자용: 값은 Vercel 서버 환경변수에만 입력합니다.
# 운영/미리보기 모두 실제 발송 전에 별도 검증이 필요합니다. 자동 mock 대체 없음.
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN
SMS_GUARD_HMAC_KEY=YOUR_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMS_GUARD_NAMESPACE=health-search-pilot
SMS_ALLOWED_ORIGINS=https://YOUR_PROJECT.vercel.app
# 2026-09-06 승인: 전체 이용자 합산, 한국시간 일 10회 / 월 100회.
# 더 낮은 값은 허용. 0/누락/승인 상한 초과는 발송 차단. 환경변수로 상한 증액 불가.
SMS_MAX_DAILY=10
SMS_MAX_MONTHLY=100
