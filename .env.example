# 로컬 개발은 sqlite, 운영은 supabase
DATA_BACKEND=sqlite
SQLITE_PATH=data/health_search.db

# LLM 보조검색: 처음에는 false
ENABLE_LLM=false
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6

# 문자 발송: 처음에는 mock
SMS_MODE=mock
SOLAPI_API_KEY=YOUR_SOLAPI_API_KEY
SOLAPI_API_SECRET=YOUR_SOLAPI_API_SECRET
SOLAPI_SENDER=YOUR_REGISTERED_SENDER_NUMBER

# Supabase 운영 전환 때 입력
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_SERVER_KEY

